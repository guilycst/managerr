{
  "openrpc": "1.2.6",
  "info": {
    "title": "Mastarr NZBGet JSON-RPC compatibility",
    "description": "Mastarr-owned compatibility contract for the read-only NZBGet methods used to reconcile downloaded media.",
    "version": "0.0.1"
  },
  "servers": [
    {
      "name": "NZBGet JSON-RPC endpoint",
      "url": "{endpoint}/jsonrpc",
      "variables": {
        "endpoint": {
          "default": "http://localhost:6789"
        }
      }
    }
  ],
  "methods": [
    {
      "name": "version",
      "summary": "Read the NZBGet version string.",
      "description": "The request has no parameters. NZBGet does not support rpc.discover in the pinned API contract.",
      "paramStructure": "by-position",
      "params": [],
      "result": {
        "name": "version",
        "schema": {
          "$ref": "#/components/schemas/VersionResult"
        }
      }
    },
    {
      "name": "listgroups",
      "summary": "Read queued download groups.",
      "description": "NumberOfLogEntries is positional and must be zero for current NZBGet versions.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "NumberOfLogEntries",
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "result": {
        "name": "listgroups",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/GroupRecord"
          }
        }
      }
    },
    {
      "name": "listfiles",
      "summary": "Read files belonging to groups.",
      "description": "All three arguments are positional. IDFrom and IDTo are deprecated and must be zero; NZBID zero requests all groups.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "IDFrom",
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "IDTo",
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "NZBID",
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "result": {
        "name": "listfiles",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/FileRecord"
          }
        }
      }
    },
    {
      "name": "history",
      "summary": "Read download history.",
      "description": "Hidden is positional. The normal reconciliation view requests false so duplicate hidden records are excluded.",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "Hidden",
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "history",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/HistoryRecord"
          }
        }
      }
    }
  ],
